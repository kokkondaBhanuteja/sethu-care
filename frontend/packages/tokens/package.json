{
  "name": "@sethu/tokens",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tailwind-preset": "./tailwind-preset.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate:css": "node --experimental-strip-types src/generate-css.ts",
