# ─────────────────────────────────────────────────────────────────────────────
# SETHU-CARE Admin Console — frontend environment (reference)
#
# Copy to `.env.local` (gitignored) and adjust. Only VITE_-prefixed variables reach the
# browser bundle, so NOTHING SECRET belongs in this file — the JWT is obtained at login and
# persisted through @sethu/core's storage adapter, never through an env var.
#
# Every variable here is declared in src/vite-env.d.ts and read only by src/lib/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# Backend base URL. Defaults to the local Go API (backend /.env.example sets ADDR=:8090).
VITE_API_URL=http://localhost:8090

# Serve screens from the typed mock services instead of the backend.
# Defaults to true, because only six of this console's endpoints exist today — see
# docs/admin-api-contract.md for the full list of what the backend still owes.
VITE_USE_MOCKS=true

# Forces mock behaviour so every screen state from Admin spec §4.10 is reachable without a
# backend. One of: normal (default) | error | empty | slow.
#   error → every read fails, exercising the error + retry state
#   empty → every read returns zero rows, exercising empty and filtered-empty
#   slow  → 3s latency, exercising skeletons and in-flight affordances
VITE_MOCK_MODE=normal
