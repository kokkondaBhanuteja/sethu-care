{
  "name": "admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:sync": "vite build && cap sync",
    "cap:ios": "vite build && cap sync ios && cap run ios",
    "cap:android": "vite build && cap sync android && cap run android",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.4",
    "@hookform/resolvers": "^5.4.0",
    "@sethu/api-client": "workspace:*",
    "@sethu/core": "workspace:*",
    "@sethu/domain": "workspace:*",
    "@sethu/i18n": "workspace:*",
    "@sethu/tokens": "workspace:*",
    "@sethu/ui-web": "workspace:*",
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.82.0",
    "react-router": "^7.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
